","name":"weight_dtype","type":"COMBO","widget":{"name":"weight_dtype"},"link":null}],"outputs":[{"localized_name":"MODEL","name":"MODEL","type":"MODEL","links":[9]}],"properties":{"Node name for S&R":"UNETLoader"},"widgets_values":["flux1-dev.safetensors","fp8_e4m3fn"]},{"id":9,"type":"ControlNetApplyAdvanced","pos":[1653.1394876491772,471.66841018200154],"size":[270,186],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"positive","name":"positive","type":"CONDITIONING","link":4},{"localized_name":"negative","name":"negative","type":"CONDITIONING","link":5},{"localized_name":"control_net","name":"control_net","type":"CONTROL_NET","link":6},{"localized_name":"image","name":"image","type":"IMAGE","link":7},{"localized_name":"vae","name":"vae","shape":7,"type":"VAE","link":8},{"localized_name":"strength","name":"strength","type":"FLOAT","widget":{"name":"strength"},"link":null},{"localized_name":"start_percent","name":"start_percent","type":"FLOAT","widget":{"name":"start_percent"},"link":null},{"localized_name":"end_percent","name":"end_percent","type":"FLOAT","widget":{"name":"end_percent"},"link":null}],"outputs":[{"localized_name":"positive","name":"positive","type":"CONDITIONING","links":[10]},{"localized_name":"negative","name":"negative","type":"CONDITIONING","links":[11]}],"properties":{"Node name for S&R":"ControlNetApplyAdvanced"},"widgets_values":[0.8,0,0.8]},{"id":10,"type":"EmptySD3LatentImage","pos":[1649.4386185495982,704.7895901421717],"size":[270,106],"flags":{},"order":2,"mode":0,"inputs":[{"localized_name":"width","name":"width","type":"INT","widget":{"name":"width"},"link":null},{"localized_name":"height","name":"height","type":"INT","widget":{"name":"height"},"link":null},{"localized_name":"batch_size","name":"batch_size","type":"INT","widget":{"name":"batch_size"},"link":null}],"outputs":[{"localized_name":"LATENT","name":"LATENT","type":"LATENT","links":[12]}],"properties":{"Node name for S&R":"EmptySD3LatentImage"},"widgets_values":[1024,1024,1]},{"id":12,"type":"VAEDecode","pos":[2536.1906945076294,594.3621429835167],"size":[140,46],"flags":{},"order":12,"mode":0,"inputs":[{"localized_name":"samples","name":"samples","type":"LATENT","link":13},{"localized_name":"vae","name":"vae","type":"VAE","link":14}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[15]}],"properties":{"Node name for S&R":"VAEDecode"},"widgets_values":[]},{"id":15,"type":"MarkdownNote","pos":[2548.331805885203,797.1793523399492],"size":[210,88],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"title":"notes parametres","properties":{},"widgets_values":[" Démo A, étape 1 : décor Flux + ControlNet depth\n**Principe** : Flux génère une photo entière, mais la depth du rendu 3D impose la forme et la place du sac. On garde le décor ; le vrai sac (beauty 3D) est recollé à l'étape 2.\n\n**Load Diffusion Model, fp8_e4m3fn** : Flux dev fait 23,8 Go en 16 bits ; converti en fp8 au chargement, il fait ~12 Go et tient dans 16 Go de VRAM. Perte de qualité minime.\n\n**DualCLIPLoader, clip_l + t5xxl, type flux** : deux encodeurs. CLIP-L capte le style et les mots-clés, T5 comprend les phrases longues.\n\n**Prompt négatif vide** : Flux dev est distillé, à cfg 1 il n'utilise pas de négatif. Le nœud est là parce qu'Apply ControlNet en exige un.\n\n**FluxGuidance 3,5** : remplace le CFG chez Flux dev (paramètre appris pendant la distillation). 3,5 = standard. Plus haut = plus fidèle au prompt mais plus contrasté et « plastique ».\n\n**Apply ControlNet, strength 0,8 / start 0 / end 0,8** : réglages recommandés par Shakker Labs pour la depth.\n- strength 0,8 : contrainte forte mais pas rigide ; 1,0 donne souvent des artefacts.\n- end 0,8 : la depth guide les premiers 80 % du débruitage (composition, volumes), puis Flux finit les détails librement.\n- VAE branché : les ControlNets Flux reçoivent la depth encodée en latent.\n- Pas de « Set Union ControlNet Type » : Union Pro 2.0 n'a plus de sélection de mode, il reconnaît la depth seul.\n\n**EmptySD3LatentImage 1024×1024** : latent à 16 canaux (format Flux ; l'Empty Latent Image classique = 4 canaux, SD/SDXL). Même taille que la depth.\n\n**KSampler : 25 steps, cfg 1,0, euler, simple, denoise 1,0**\n- cfg 1 : la guidance est déjà gérée par FluxGuidance ; monter le cfg doublerait le calcul et brûlerait l'image.\n- euler + simple : le couple standard pour Flux, stable et prévisible.\n- 25 steps : bon compromis qualité/temps (20 à 30 habituellement).\n- denoise 1,0 : on part de bruit pur, toute l'image est générée."],"color":"#233","bgcolor":"#355","shape":1},{"id":11,"type":"KSampler","pos":[2140.7942328123704,121.59160376360013],"size":[270,262],"flags":{},"order":11,"mode":0,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":9},{"localized_name":"positive","name":"positive","type":"CONDITIONING","link":10},{"localized_name":"negative","name":"negative","type":"CONDITIONING","link":11},{"localized_name":"latent_image","name":"latent_image","type":"LATENT","link":12},{"localized_name":"seed","name":"seed","type":"INT","widget":{"name":"seed"},"link":null},{"localized_name":"steps","name":"steps","type":"INT","widget":{"name":"steps"},"link":null},{"localized_name":"cfg","name":"cfg","type":"FLOAT","widget":{"name":"cfg"},"link":null},{"localized_name":"sampler_name","name":"sampler_name","type":"COMBO","widget":{"name":"sampler_name"},"link":null},{"localized_name":"scheduler","name":"scheduler","type":"COMBO","widget":{"name":"scheduler"},"link":null},{"localized_name":"denoise","name":"denoise","type":"FLOAT","widget":{"name":"denoise"},"link":null}],"outputs":[{"localized_name":"LATENT","name":"LATENT","type":"LATENT","links":[13]}],"properties":{"Node name for S&R":"KSampler"},"widgets_values":[959514798504235,"randomize",25,1,"euler","simple",1]},{"id":13,"type":"SaveImage","pos":[2773.8914966677994,594.3624998042744],"size":[270,270],"flags":{},"order":13,"mode":0,"inputs":[{"localized_name":"images"